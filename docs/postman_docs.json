{
    "info": {
        "name": "Safe NL-to-SQL Analytics Assistant",
        "description": "Postman collection for testing the Safe NL-to-SQL Analytics Assistant API.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:5000"
        },
        {
            "key": "api_key",
            "value": "local-demo-key"
        }
    ],
    "item": [
        {
            "name": "Health",
            "item": [
                {
                    "name": "Root Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/health",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "health"
                            ]
                        }
                    }
                },
                {
                    "name": "API Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/health",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "health"
                            ]
                        }
                    }
                },
                {
                    "name": "Readiness Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/ready",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "ready"
                            ]
                        }
                    }
                },
                {
                    "name": "Service Info",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/info",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "info"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Query",
            "item": [
                {
                    "name": "Query - Dry Run",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-API-Key",
                                "value": "{{api_key}}",
                                "disabled": true
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"question\": \"Show employees in Engineering who joined after 2023\",\n  \"dry_run\": true\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/query",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "query"
                            ]
                        }
                    }
                },
                {
                    "name": "Query - Execute",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-API-Key",
                                "value": "{{api_key}}",
                                "disabled": true
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"question\": \"Show employees in Engineering who joined after 2023\",\n  \"dry_run\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/query",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "query"
                            ]
                        }
                    }
                },
                {
                    "name": "Query - Aggregate",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-API-Key",
                                "value": "{{api_key}}",
                                "disabled": true
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"question\": \"How many active employees are there in each department?\",\n  \"dry_run\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/query",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "query"
                            ]
                        }
                    }
                },
                {
                    "name": "Query - Project Budget",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-API-Key",
                                "value": "{{api_key}}",
                                "disabled": true
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"question\": \"Show active projects with budget greater than 100000\",\n  \"dry_run\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/query",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "query"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Audit",
            "item": [
                {
                    "name": "Query History",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-API-Key",
                                "value": "{{api_key}}",
                                "disabled": true
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/query-history?limit=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "query-history"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                }
            ]
        }
    ]
}