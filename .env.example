APP_NAME=Safe NL-to-SQL Analytics Assistant
APP_VERSION=1.0.0
APP_ENV=development

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

DATABASE_PATH=data/safe_analytics.db

MAX_QUERY_ROWS=100
MAX_QUERY_SECONDS=5

ENABLE_MUTEX=False
APP_MUTEX_NAME=safe_nl_to_sql_analytics_assistant

ENABLE_API_KEY_AUTH=False
APP_API_KEY=local-demo-key

ENABLE_RATE_LIMITING=True
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_QUERY=30 per minute